#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
/.idea/database-helpers-go.iml
/specs
/AGENTS.md
/opencode.json
/tui.json
/.utcp_config.json
/CLAUDE.md
/.claude
/.claude/settings.local.json
/.claude/commands
/.opencode
/.opencode/agent
/.opencode/command
/.opencode/install_guides
/.opencode/skill
/.opencode/knowledge
/.opencode/knowledge/assets
/.opencode/knowledge/references
